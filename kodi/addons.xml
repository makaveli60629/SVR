<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="repository.king" name="King Kodi Repository" version="1.0.0" provider-name="King">
  <extension point="xbmc.addon.repository">
    <dir>
      <info compressed="false">https://svrpoker.com/kodi/addons.xml</info>
      <checksum>https://svrpoker.com/kodi/addons.xml.md5</checksum>
      <datadir zip="true">https://svrpoker.com/kodi/</datadir>
      <hashes>false</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_US">King Kodi Repository</summary>
    <description lang="en_US">Preview repository for King Kodi add-ons hosted at svrpoker.com/kodi.</description>
    <platform>all</platform>
    <license>MIT</license>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
<addon id="plugin.video.kingmedia" name="King Media" version="1.0.0" provider-name="King">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_US">King Media preview</summary>
    <description lang="en_US">A lightweight test add-on used to verify the King Kodi Repository installation and update path.</description>
    <platform>all</platform>
    <license>MIT</license>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
</addons>
