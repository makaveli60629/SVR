# SVR Poker backend environment example — never commit real credentials.
NODE_ENV=production
PORT=8080
ALLOWED_ORIGINS=https://svrpoker.com,https://www.svrpoker.com

# Optional service integration flags used by /api/health.
# Populate only after the corresponding service is deployed and verified.
PLAYER_ACCOUNT_API_BASE=
TOURNAMENT_API_BASE=

# Database credentials belong in the deployment secret store, not this file.
DATABASE_URL=
DB_SERVER=
AZURE_SQL_CONNECTION_STRING=

# Enterprise/admin backend entrypoints require these values and must fail closed when absent.
ADMIN_JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Store checkout remains disabled until product mapping and secret storage are approved.
STORE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
