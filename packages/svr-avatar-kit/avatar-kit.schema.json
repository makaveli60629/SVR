{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svrpoker.com/schemas/avatar-kit-v2.json",
  "title": "SVR Poker Avatar Kit v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseBodyId", "appearance", "morphs", "equipment"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "baseBodyId": { "type": "string", "minLength": 1 },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skinToneId", "eyeColorId", "hairStyleId", "hairColorId", "nailStyleId", "nailColorId"],
      "properties": {
        "skinToneId": { "type": "string" },
        "eyeColorId": { "type": "string" },
        "hairStyleId": { "type": "string" },
        "hairColorId": { "type": "string" },
        "nailStyleId": { "type": "string" },
        "nailColorId": { "type": "string" }
      }
    },
    "morphs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["height", "bodyMass", "shoulderWidth", "torsoLength", "armLength", "legLength", "handScale", "footScale"],
      "properties": {
        "height": { "$ref": "#/$defs/normalized" },
        "bodyMass": { "$ref": "#/$defs/normalized" },
        "shoulderWidth": { "$ref": "#/$defs/normalized" },
        "torsoLength": { "$ref": "#/$defs/normalized" },
        "armLength": { "$ref": "#/$defs/normalized" },
        "legLength": { "$ref": "#/$defs/normalized" },
        "handScale": { "$ref": "#/$defs/normalized" },
        "footScale": { "$ref": "#/$defs/normalized" }
      }
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hair", "headwear", "eyewear", "faceAccessory", "top", "outerwear", "bottom", "shoes", "neck", "wristLeft", "wristRight", "handLeft", "handRight"],
      "properties": {
        "hair": { "$ref": "#/$defs/itemId" },
        "headwear": { "$ref": "#/$defs/itemId" },
        "eyewear": { "$ref": "#/$defs/itemId" },
        "faceAccessory": { "$ref": "#/$defs/itemId" },
        "top": { "$ref": "#/$defs/itemId" },
        "outerwear": { "$ref": "#/$defs/itemId" },
        "bottom": { "$ref": "#/$defs/itemId" },
        "shoes": { "$ref": "#/$defs/itemId" },
        "neck": { "$ref": "#/$defs/itemId" },
        "wristLeft": { "$ref": "#/$defs/itemId" },
        "wristRight": { "$ref": "#/$defs/itemId" },
        "handLeft": { "$ref": "#/$defs/itemId" },
        "handRight": { "$ref": "#/$defs/itemId" }
      }
    },
    "profileCosmetics": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional non-body cosmetics such as portrait frame, title, badge, pose, and emote selections."
    }
  },
  "$defs": {
    "normalized": { "type": "number", "minimum": 0, "maximum": 1 },
    "itemId": { "type": "string", "minLength": 1 }
  }
}
