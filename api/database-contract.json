  "playerAws": {
    "authority": "site/config/player-api.json + infrastructure/aws/phase372-player-account-foundation.yml",
    "identity": "cognito",
    "database": "dynamodb",
    "remoteEndpointState": "pending-until-verified",
    "profileTable": {
      "partitionKey": "playerId",
      "globalSecondaryIndex": {
        "name": "normalized-email",
        "partitionKey": "normalizedEmail"
      },
      "requiredFields": [
        "schemaVersion",
        "playerId",
        "normalizedEmail",
        "email",
        "displayName",
        "role",
        "playMoney",
        "dailyStreak",
        "lastRewardClaim",
