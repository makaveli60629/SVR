        "equippedOutfit",
        "inventory",
        "createdAt",
        "updatedAt",
        "lastLoginAt",
        "isActive"
      ]
    },
    "sessionTable": {
      "partitionKey": "sessionId",
      "ttlField": "expiresAt",
      "globalSecondaryIndex": {
        "name": "player-started-at",
        "partitionKey": "playerId",
        "sortKey": "startedAt"
      },
      "requiredFields": [
        "schemaVersion",
        "sessionId",
        "playerId",
        "platform",
        "startedAt",
        "lastHeartbeatAt",
        "activeSeconds",
        "heartbeatCount",
        "endedAt",
        "expiresAt",
        "metadata"
      ]
    }
