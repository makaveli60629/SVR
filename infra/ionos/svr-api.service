[Unit]
Description=SVR Poker API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/svr/api
EnvironmentFile=/etc/svr/api.env
ExecStart=/usr/bin/node /opt/svr/api/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
